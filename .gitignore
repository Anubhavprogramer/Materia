# ===================================
# Project Specific
# ===================================

# Temporary documentation files
*_FIX.md
*_SUCCESS.md
*_TEST.md
BOND_HANDLING_TEST.md
VALIDATION_VIEW_FIX.md
COREML_COMPATIBILITY_FIX.md
BOND_PROPERTY_FIX.md
COREML_INPUT_NAME_FIX.md

# Training data (keep structure but not large datasets)
model_training/data/*.csv
model_training/data/*.json
model_training/data/*.npy
model_training/data/*.pkl

# Keep important model files but ignore temporary ones
!model_training/models/*.mlpackage
!model_training/models/preprocessing_info.json
!model_training/models/iupac_rules.json

# Ignore large model files
model_training/models/best_*.h5
model_training/models/checkpoint_*.h5

# Configuration files with sensitive data
config.json
secrets.json
api_keys.json

# ===================================
# Keep Important Files
# ===================================

# Force include important files even if they match patterns above
!README.md
!CUSTOM_MODELS_README.md
!UPDATE_INSTRUCTIONS.md
!Materia/CoreMLModel/*.mlpackage/
!Materia/CoreMLModel/preprocessing_info.json
!Materia/CoreMLModel/iupac_rules.json
!Materia/CoreMLModel/*.md
!model_training/requirements.txt
!model_training/*.py

# ===================================
# Comments for Future Reference
# ===================================

# This .gitignore is designed for the Materia chemistry app which includes:
# - iOS Swift/SwiftUI app with CoreML models
# - Python machine learning training pipeline
# - Custom chemistry models and data processing
# 
# Key inclusions:
# - CoreML .mlpackage files (essential for iOS app)
# - Python training scripts
# - Configuration and documentation files
# 
# Key exclusions:
# - Large training datasets and temporary model files
# - Build artifacts and cache files
# - IDE-specific files
# - Temporary documentation files created during development

*.md